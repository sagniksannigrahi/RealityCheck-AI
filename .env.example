# Copy to .env and adjust. All variables are optional for local development.
# ---- general ----
RC_ENVIRONMENT=development            # "production" refuses to start with the default secret key
RC_SECRET_KEY=change-me               # signs media URLs; set a long random value in production
RC_LOG_LEVEL=INFO
RC_LOG_JSON=true

# ---- database ----  (default: SQLite file in ./data; Docker Compose uses PostgreSQL)
# RC_DATABASE_URL=postgresql+psycopg://realitycheck:password@localhost:5432/realitycheck
POSTGRES_PASSWORD=realitycheck-dev

# ---- storage ----
RC_STORAGE_BACKEND=local              # local | s3 (requires the "s3" extra)
# RC_STORAGE_ROOT=./data/storage
# RC_S3_BUCKET=
# RC_S3_ENDPOINT_URL=
RC_MEDIA_RETENTION_DAYS=30

# ---- auth ----
RC_AUTH_REQUIRED=false
RC_API_KEYS=                          # comma-separated keys; each key gets its own private job history
RC_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
RC_RATE_LIMIT_PER_MINUTE=60

# ---- models ----
RC_MODEL_BACKEND=auto                 # real | demo | auto (real if ML deps import, else demo)
RC_DEVICE=cpu                         # cpu | mps | cuda | auto
RC_MAX_CONCURRENT_INFERENCE=1
RC_MODEL_IDLE_UNLOAD_SECONDS=0        # >0 frees model memory after inactivity
RC_DETECTOR_WEIGHTS=data/models/yolo11n.pt
RC_GROUNDING_MODEL_ID=IDEA-Research/grounding-dino-tiny
RC_VLM_PROVIDER=smolvlm               # smolvlm (local) | anthropic (external, opt-in)
RC_VLM_MODEL_ID=HuggingFaceTB/SmolVLM-500M-Instruct
RC_GENERATOR_MODEL_ID=HuggingFaceTB/SmolVLM-500M-Instruct
RC_VLM_IMAGE_SPLITTING=false          # true = more detail, ~10x slower on CPU
RC_PIN_MODEL_REVISIONS=true          # load the Hub commits the models were tested with
# RC_MODEL_REVISIONS={"HuggingFaceTB/SmolVLM-500M-Instruct": "<commit sha>"}   # override pins (JSON)

# ---- external provider (images leave this machine!) ----
RC_ALLOW_EXTERNAL_PROVIDERS=false
RC_ANTHROPIC_API_KEY=
RC_ANTHROPIC_MODEL=claude-opus-5-5

# ---- processing limits ----
RC_WORKER_MODE=inline                 # inline (API runs a worker thread) | external (separate worker process)
RC_JOB_TIMEOUT_SECONDS=900
RC_MAX_IMAGE_BYTES=15728640
RC_MAX_VIDEO_BYTES=104857600
RC_MAX_VIDEO_SECONDS=120
RC_VIDEO_SAMPLING_STRATEGY=scene_aware
RC_VIDEO_MAX_SAMPLED_FRAMES=16

# ---- calibrated probabilities (optional; produced by scripts/run_evaluation.py) ----
# RC_CALIBRATION_PATH=experiments/runs/<run>/calibrator_eav_sa.json
